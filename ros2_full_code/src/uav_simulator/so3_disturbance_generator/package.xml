<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>so3_disturbance_generator</name>
  <version>0.0.1</version>
  <description>Injects drift, noise, and force/moment disturbances into odometry (ROS 2 params, no dynamic_reconfigure).</description>
  <maintainer email="todo@todo.todo">RACER maintainers</maintainer>
  <license>GPL-3.0-only</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>pose_utils</depend>
  <depend>libarmadillo-dev</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
