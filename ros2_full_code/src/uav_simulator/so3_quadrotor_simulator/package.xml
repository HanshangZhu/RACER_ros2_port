<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>so3_quadrotor_simulator</name>
  <version>0.0.1</version>
  <description>Quadrotor rigid-body dynamics simulator (ode/odeint).</description>
  <maintainer email="todo@todo.todo">RACER maintainers</maintainer>
  <license>GPL-3.0-only</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>quadrotor_msgs</depend>
  <depend>uav_utils</depend>
  <depend>eigen3_cmake_module</depend>
  <depend>eigen</depend>
  <depend>libarmadillo-dev</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
